{
  "name": "@wxy/massing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic massing engine shared by 3A Massing Studio and 3C Option Field (TypeScript source, no build step).",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./data/*",
    "./test-fixtures/*": "./src/__tests__/fixtures/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "samples": "tsx scripts/build-samples.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "earcut": "^3.2.4",
    "manifold-3d": "^3.5.4",
    "suncalc": "^2.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "proj4": "^2.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
